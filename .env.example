# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Multi-domain & Subdomain URLs
PUBLIC_APP_URL="https://www.swarnaestate.in"
ADMIN_APP_URL="https://admin.swarnaestate.in"
PARTNER_APP_URL="https://partner.swarnaestate.in"
DEVELOPER_APP_URL="https://developer.swarnaestate.in"

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/swarna_realestate?schema=public"

# Auth Session Secret
SESSION_SECRET="super-secret-crypto-random-key-change-in-production"

# Object Storage / S3 / R2
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""

# Redis Cache & Background Jobs
REDIS_URL=""

# Third-Party Webhook Secrets
META_WEBHOOK_SECRET="meta_lead_wh_secret_xyz"
GOOGLE_WEBHOOK_SECRET="google_lead_wh_secret_xyz"
