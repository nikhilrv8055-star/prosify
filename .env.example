# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Multi-domain & Subdomain URLs
PUBLIC_APP_URL="https://www.prosify.in"
ADMIN_APP_URL="https://admin.prosify.in"
PARTNER_APP_URL="https://partner.prosify.in"
DEVELOPER_APP_URL="https://developer.prosify.in"

# Database Configuration (PostgreSQL / Supabase / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/prosify_db?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# CRM Lead Capture & Webhook Integration System
# ==========================================
# CRM_PROVIDER: "webhook" (default, Zapier, Make.com, Pabbly), "zoho", "hubspot", or "leadsquared"
CRM_PROVIDER="webhook"

# CRM_API_ENDPOINT: Target Webhook URL or API endpoint where incoming leads will be dispatched
# E.g. Zapier webhook: https://hooks.zapier.com/hooks/catch/1234567/abcdef/
# E.g. Make.com webhook: https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxxxx
# E.g. Zoho CRM Leads API: https://www.zohoapis.com/crm/v2/Leads
# E.g. HubSpot Contacts API: https://api.hubapi.com/crm/v3/objects/contacts
CRM_API_ENDPOINT="https://hooks.zapier.com/hooks/catch/YOUR_WEBHOOK_ID"

# Authentication Credentials for target CRM
CRM_API_KEY=""
CRM_BEARER_TOKEN=""

# Retry and timeout policies (optional overrides)
CRM_MAX_RETRIES="3"
CRM_INITIAL_BACKOFF_MS="500"
CRM_MAX_BACKOFF_MS="4000"
CRM_TIMEOUT_MS="10000"

# Realatic CRM Integration (External CRM)
# If credentials are not set, integration operates in PENDING CREDENTIALS mode
REALATIC_API_URL="https://api.realatic.com/v1"
REALATIC_API_KEY=""
REALATIC_WEBHOOK_SECRET=""

# WhatsApp Business Cloud API Integration
# If credentials are not set, integration operates in PENDING CREDENTIALS mode
WHATSAPP_API_URL="https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_API_TOKEN=""

# AI Engine Key
AI_API_KEY=""

# Auth Session Secret
SESSION_SECRET="super-secret-crypto-random-key-change-in-production"

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_DATABASE_ID="0429eb5c-27a5-4fb8-8fac-c53e09f8036d"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""

# Third-Party Webhook Secrets
META_WEBHOOK_SECRET="meta_lead_wh_secret_xyz"
GOOGLE_WEBHOOK_SECRET="google_lead_wh_secret_xyz"
