{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2048 next dev -p 3000",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=2048 NODE_ENV=production next build",
    "build:cloudflare": "cross-env NODE_OPTIONS=--max-old-space-size=2048 NODE_ENV=production opennextjs-cloudflare build",
    "start": "next start -p 3000",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "clean": "rimraf .next .open-next",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "d1:create": "wrangler d1 create prosify_production",
    "d1:migrate:local": "wrangler d1 migrations apply prosify_production --local",
    "d1:migrate:remote": "wrangler d1 migrations apply prosify_production --remote",
    "r2:create": "wrangler r2 bucket create prosify-uploads && wrangler r2 bucket create prosify-cache"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.27",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.27",
    "rimraf": "^6.0.1",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wrangler": "^4.136.2"
  }
}
