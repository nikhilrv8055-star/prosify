{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' next dev -p 3000",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' NODE_ENV=production next build",
    "build:cloudflare": "NODE_OPTIONS='--max-old-space-size=2048' NODE_ENV=production opennextjs-cloudflare build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "clean": "next clean",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "d1:create": "wrangler d1 create prosify_production",
    "d1:migrate:local": "wrangler d1 execute prosify_production --local --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute prosify_production --remote --file=./migrations/0001_initial_schema.sql",
    "d1:seed:local": "wrangler d1 execute prosify_production --local --file=./migrations/0002_seed_data.sql",
    "d1:seed:remote": "wrangler d1 execute prosify_production --remote --file=./migrations/0002_seed_data.sql",
    "r2:create": "wrangler r2 bucket create prosify-uploads && wrangler r2 bucket create prosify-cache"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.16",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cloudflare": "^4.5.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.16",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wrangler": "^4.136.2"
  }
}
