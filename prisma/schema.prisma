// Prisma Schema for Prosify Real Estate Marketplace & AI Realty Operating System
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  AGENT
  AFFILIATE
  VERIFICATION_OFFICER
  SALES_MANAGER
  SALES_AGENT
  SALES_EXECUTIVE
  DEVELOPER
  CHANNEL_PARTNER
  FRANCHISE
  MARKETING_MANAGER
  FINANCE
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_FIRST_LOGIN
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  PENTHOUSE
  OFFICE
  SHOP
  COMMERCIAL
  WAREHOUSE
}

enum ListingType {
  BUY
  RENT
  COMMERCIAL
  PROJECT
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  NEW_LAUNCH
}

enum UnitStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
  BLOCKED
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  LOST
  CLOSED
}

enum LeadSourceType {
  WEBSITE
  CHANNEL_PARTNER
  FACEBOOK
  GOOGLE
  NINETY_NINE_ACRES
  MAGICBRICKS
  HOUSING
  API
  MANUAL
  OTHER
}

enum SiteVisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  CANCELLED
}

enum SyncSourceType {
  API
  CSV_UPLOAD
  EXCEL
  WEBHOOK
  MANUAL
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
  RUNNING
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  phone                 String?
  name                  String
  passwordHash          String
  role                  UserRole          @default(CUSTOMER)
  status                AccountStatus     @default(ACTIVE)
  secureId              String?           @unique
  requirePasswordChange Boolean           @default(false)
  avatarUrl             String?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  sessions              Session[]
  partner               ChannelPartner?
  developer             Developer?
  assignedLeads         LeadAssignment[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  savedProps            SavedProperty[]
  affiliateProfile      AffiliateProfile?
  vendorProfile         VendorProfile?
  agentProfile          AgentProfile?
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String
  gstNumber           String?
  panNumber           String?
  category            String
  territory           String
  bankAccountHolder   String?
  bankAccountNumber   String?
  bankIfscCode        String?
  bankName            String?
  totalSettledAmount  Float    @default(0)
  pendingClearance    Float    @default(0)
  activeListingsCount Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("VendorProfiles")
}

model AgentProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName            String
  reraNumber            String?
  territory             String
  monthlyTargetInr      Float    @default(0)
  achievedVolumeInr     Float    @default(0)
  closedDealsCount      Int      @default(0)
  commissionRatePercent Float    @default(2.0)
  totalCommissionEarned Float    @default(0)
  pendingCommission     Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("AgentProfiles")
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  districts District[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  stateId  String
  state    State    @relation(fields: [stateId], references: [id])
  cities   City[]
}

model City {
  id         String     @id @default(cuid())
  name       String
  districtId String
  district   District   @relation(fields: [districtId], references: [id])
  zones      Zone[]
  properties Property[]
  projects   Project[]
}

model Zone {
  id          String      @id @default(cuid())
  name        String
  cityId      String
  city        City        @relation(fields: [cityId], references: [id])
  localities  Locality[]
}

model Locality {
  id          String      @id @default(cuid())
  name        String
  pincode     String?
  zoneId      String
  zone        Zone        @relation(fields: [zoneId], references: [id])
  properties  Property[]
  projects    Project[]
}

model Developer {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  logoUrl        String?
  about          String?
  establishedYr  Int?
  website        String?
  contactEmail   String?
  contactPhone   String?
  isVerified     Boolean             @default(false)
  userId         String?             @unique
  user           User?               @relation(fields: [userId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  projects       Project[]
  properties     Property[]
  documents      DeveloperDocument[]
  syncSources    DeveloperSyncSource[]
}

model DeveloperDocument {
  id          String    @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  docType     String
  fileUrl     String
  fileName    String
  uploadedAt  DateTime  @default(now())
}

model DeveloperSyncSource {
  id             String         @id @default(cuid())
  developerId    String
  developer      Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  sourceType     SyncSourceType
  apiUrl         String?
  apiKeyEncrypted String?
  syncFrequency  String         @default("HOURLY")
  lastSyncAt     DateTime?
  status         SyncStatus     @default(SUCCESS)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  syncJobs       SyncJob[]
}

model SyncJob {
  id              String              @id @default(cuid())
  syncSourceId    String
  syncSource      DeveloperSyncSource @relation(fields: [syncSourceId], references: [id], onDelete: Cascade)
  recordsReceived Int                 @default(0)
  recordsCreated  Int                 @default(0)
  recordsUpdated  Int                 @default(0)
  recordsFailed   Int                 @default(0)
  status          SyncStatus
  durationMs      Int                 @default(0)
  errorLog        String?
  createdAt       DateTime            @default(now())
}

model Project {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  developerId      String
  developer        Developer        @relation(fields: [developerId], references: [id])
  cityId           String
  city             City             @relation(fields: [cityId], references: [id])
  localityId       String
  locality         Locality         @relation(fields: [localityId], references: [id])
  address          String
  latitude         Float?
  longitude        Float?
  startingPrice    Float
  priceRange       String
  configurations   String
  totalUnits       Int
  availableUnits   Int
  possessionDate   String
  constructionStatus PossessionStatus
  reraNumber       String
  description      String
  brochureUrl      String?
  isFeatured       Boolean          @default(false)
  isPublished      Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  towers           Tower[]
  floorPlans       FloorPlan[]
  media            ProjectMedia[]
  amenities        ProjectAmenity[]
  properties       Property[]
  leads            Lead[]
  siteVisits       SiteVisit[]
  bookings         Booking[]
  commissionRules  CommissionRule[]
}

model ProjectMedia {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaType  String   // IMAGE, VIDEO, VIRTUAL_TOUR
  url        String
  caption    String?
  sortOrder  Int      @default(0)
}

model ProjectAmenity {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
}

model FloorPlan {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  bhk        String
  carpetArea Float
  price      Float
  imageUrl   String
}

model Tower {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  totalFloors Int
  floors     Floor[]
}

model Floor {
  id         String   @id @default(cuid())
  towerId    String
  tower      Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  floorNumber Int
  units      Unit[]
}

model Unit {
  id           String     @id @default(cuid())
  floorId      String
  floor        Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber   String
  bhk          String
  configuration String
  carpetArea   Float
  builtUpArea  Float
  balconyArea  Float?
  price        Float
  parking      String?
  facing       String?
  status       UnitStatus @default(AVAILABLE)
  possession   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  booking      Booking?
}

model Property {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  listingType      ListingType      @default(BUY)
  propertyType     PropertyType     @default(APARTMENT)
  price            Float
  pricePerSqft     Float
  bhk              String
  carpetArea       Float
  builtUpArea      Float
  floorNumber      Int?
  totalFloors      Int?
  facing           String?
  furnishingStatus String?          // UNFURNISHED, SEMI_FURNISHED, FULLY_FURNISHED
  possessionStatus PossessionStatus @default(READY_TO_MOVE)
  possessionDate   String?
  isVerified       Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  isPublished      Boolean          @default(true)
  reraNumber       String?
  cityId           String
  city             City             @relation(fields: [cityId], references: [id])
  localityId       String
  locality         Locality         @relation(fields: [localityId], references: [id])
  developerId      String?
  developer        Developer?       @relation(fields: [developerId], references: [id])
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])
  description      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  media            PropertyMedia[]
  amenities        PropertyAmenity[]
  leads            Lead[]
  siteVisits       SiteVisit[]
  bookings         Booking[]
  savedBy          SavedProperty[]
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  mediaType  String   @default("IMAGE")
  isFeatured Boolean  @default(false)
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model ChannelPartner {
  id             String          @id @default(cuid())
  code           String          @unique // e.g. CP101
  companyName    String
  partnerName    String
  email          String          @unique
  phone          String
  address        String?
  gstNumber      String?
  panNumber      String
  reraNumber     String?
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  status         PartnerStatus   @default(PENDING)
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  trackingLinks  TrackingLink[]
  leads          Lead[]
  siteVisits     SiteVisit[]
  bookings       Booking[]
  commissions    Commission[]
  payouts        Payout[]
  documents      PartnerDocument[]
}

model PartnerDocument {
  id         String         @id @default(cuid())
  partnerId  String
  partner    ChannelPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  docType    String
  fileUrl    String
  fileName   String
  uploadedAt DateTime       @default(now())
}

model TrackingLink {
  id          String          @id @default(cuid())
  partnerId   String
  partner     ChannelPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code        String          @unique
  targetUrl   String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  clicks      Int             @default(0)
  createdAt   DateTime        @default(now())

  events      TrackingEvent[]
}

model TrackingEvent {
  id             String       @id @default(cuid())
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  eventType      String       // CLICK, PROPERTY_VIEW, PROJECT_VIEW, ENQUIRY
  ipAddress      String?
  userAgent      String?
  referrer       String?
  createdAt      DateTime     @default(now())
}

model Lead {
  id           String         @id @default(cuid())
  name         String
  phone        String
  email        String?
  source       LeadSourceType @default(WEBSITE)
  propertyId   String?
  property     Property?      @relation(fields: [propertyId], references: [id])
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id])
  partnerId    String?
  partner      ChannelPartner? @relation(fields: [partnerId], references: [id])
  budget       String?
  requirement  String?
  location     String?
  status       LeadStatus     @default(NEW)
  notes        String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  firstTouch   String?
  lastTouch    String?
  city         String?
  inquiryType  String?
  leadTag      String?
  affiliateId  String?
  sourceUrl    String?
  ipAddress    String?
  crmSyncStatus String        @default("PENDING") // PENDING, SYNCED, FAILED
  crmProvider  String?
  crmLeadId    String?
  crmSyncedAt  DateTime?
  crmRetryCount Int           @default(0)
  crmLastError String?
  crmPayload   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assignments  LeadAssignment[]
  activities   LeadActivity[]
  siteVisits   SiteVisit[]
  bookings     Booking[]
  crmSyncLogs  CrmSyncLogRecord[]
}

model CrmSyncLogRecord {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  crmProvider    String
  requestPayload String
  responsePayload String?
  statusCode     Int
  errorMessage   String?
  syncStatus     String    @default("PENDING") // SYNCED, FAILED, PENDING
  retryCount     Int       @default(0)
  durationMs     Int       @default(0)
  createdAt      DateTime  @default(now())
}

model LeadAssignment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
}

model LeadActivity {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activity   String
  notes      String?
  createdAt  DateTime @default(now())
}

model SiteVisit {
  id              String          @id @default(cuid())
  leadId          String
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId      String?
  property        Property?       @relation(fields: [propertyId], references: [id])
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  partnerId       String?
  partner         ChannelPartner? @relation(fields: [partnerId], references: [id])
  salesExecutive  String?
  visitDate       String
  visitTime       String
  status          SiteVisitStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Booking {
  id            String          @id @default(cuid())
  leadId        String
  lead          Lead            @relation(fields: [leadId], references: [id])
  propertyId    String?
  property      Property?       @relation(fields: [propertyId], references: [id])
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id])
  unitId        String?         @unique
  unit          Unit?           @relation(fields: [unitId], references: [id])
  partnerId     String?
  partner       ChannelPartner? @relation(fields: [partnerId], references: [id])
  customerName  String
  customerPhone String
  bookingDate   DateTime        @default(now())
  bookingAmount Float
  totalAgreementValue Float
  commissionAmt Float           @default(0)
  status        String          @default("CONFIRMED")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  commissions   Commission[]
}

model CommissionRule {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  ruleType    String   // PERCENTAGE, FIXED
  rate        Float    // e.g. 2.0% or 50000
  effectiveFrom DateTime @default(now())
}

model Commission {
  id          String           @id @default(cuid())
  partnerId   String
  partner     ChannelPartner   @relation(fields: [partnerId], references: [id])
  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id])
  amount      Float
  ratePercent Float?
  status      CommissionStatus @default(PENDING)
  approvedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Payout {
  id            String         @id @default(cuid())
  partnerId     String
  partner       ChannelPartner @relation(fields: [partnerId], references: [id])
  amount        Float
  utrNumber     String?
  paymentMethod String         @default("NEFT")
  paidAt        DateTime       @default(now())
  notes         String?
}

model Integration {
  id          String    @id @default(cuid())
  provider    String    @unique // META, GOOGLE, 99ACRES, MAGICBRICKS, HOUSING, CRM
  displayName String
  isConnected Boolean   @default(false)
  apiKey      String?
  webhookUrl  String?
  lastSyncAt  DateTime?
  statusText  String    @default("Pending Provider API Access")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  signature   String?
  payload     String
  isProcessed Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // LEAD, VISIT, BOOKING, COMMISSION, SYNC
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  ipAddress  String?
  metadata   String?
  createdAt  DateTime @default(now())
}

model SeoMetadata {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String
  canonical   String?
  ogImage     String?
  keywords    String?
}

model ReraRecord {
  id                 String    @id @default(uuid())
  projectId          String
  projectName        String
  reraNumber         String
  registeredName     String
  promoterName       String
  projectType        String?
  totalLandAreaSqMtr Float?
  validUntil         DateTime
  status             String    @default("UNDER_REVIEW")
  extractedData      String?
  mismatches         String?
  rawResponse        String?
  lastCheckedAt      DateTime  @default(now())
}

model BuyerRequirement {
  id                   String    @id @default(uuid())
  userId               String?
  fullName             String
  phone                String
  email                String?
  locations            String
  budgetMin            Float     @default(0)
  budgetMax            Float
  configuration        String
  purpose              String    @default("END_USE")
  possessionPreference String    @default("ANY")
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
}

model CrmSyncLog {
  id              String    @id @default(uuid())
  leadId          String
  leadName        String
  leadPhone       String
  crmProvider     String    @default("REALATIC")
  requestPayload  String?
  responsePayload String?
  statusCode      Int?
  errorMessage    String?
  syncStatus      String    @default("PENDING")
  idempotencyKey  String    @unique
  syncTimestamp   DateTime  @default(now())
}

model AiAgentAction {
  id               String    @id @default(uuid())
  agentName        String
  inputContext     String?
  modelUsed        String
  outputGenerated  String?
  confidenceScore  Float     @default(0)
  approvalRequired Boolean   @default(false)
  isApproved       Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  actionTaken      String?
  createdAt        DateTime  @default(now())
}

model AffiliateProfile {
  id                   String                @id @default(uuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateCode        String                @unique
  customSlug           String?               @unique
  tier                 String                @default("Bronze") // Bronze, Silver, Gold, Platinum
  commissionRate       Float                 @default(2.5)
  availableBalance     Float                 @default(0.0)
  totalEarnings        Float                 @default(0.0)
  pendingClearance     Float                 @default(0.0)
  paidOutAmount        Float                 @default(0.0)
  totalClicks          Int                   @default(0)
  totalConversions     Int                   @default(0)
  conversionRate       Float                 @default(0.0)
  status               String                @default("ACTIVE") // ACTIVE, UNDER_REVIEW, BANNED
  emailNotifications   Boolean               @default(true)
  smsNotifications     Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  bankDetails          BankDetails?
  clicks               ReferralClick[]
  conversions          AffiliateConversion[]
  payoutRequests       PayoutRequest[]
}

model BankDetails {
  id                   String           @id @default(uuid())
  affiliateId          String           @unique
  affiliate            AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  accountHolderName    String
  accountNumber        String
  ifscCode             String
  bankName             String
  upiId                String?
  panNumber            String?
  isVerified           Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model ReferralClick {
  id                   String           @id @default(uuid())
  affiliateId          String
  affiliate            AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipAddress            String?
  userAgent            String?
  targetPath           String           @default("/")
  referrerUrl          String?
  country              String?          @default("IN")
  isBlockedFraud       Boolean          @default(false)
  blockedReason        String?
  createdAt            DateTime         @default(now())
}

model AffiliateConversion {
  id                   String           @id @default(uuid())
  affiliateId          String
  affiliate            AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  campaignSource       String           @default("Direct Referral")
  conversionEvent      String           // Lead Form, Site Visit, Token Booking, Deed Registration
  dealAmount           Float            @default(0)
  commissionAmount     Float
  status               String           @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  customerName         String?
  propertyTitle        String?
  rejectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model PayoutRequest {
  id                   String           @id @default(uuid())
  affiliateId          String
  affiliate            AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount               Float
  tdsDeduction         Float            @default(0)
  netPayable           Float
  payoutMethod         String           // UPI, NEFT, IMPS
  destinationDetails   String
  status               String           @default("PENDING") // PENDING, APPROVED, REJECTED
  transactionRef       String?          // UTR reference
  rejectionReason      String?
  receiptUrl           String?
  requestedAt          DateTime         @default(now())
  processedAt          DateTime?
}

model AffiliateProgramConfig {
  id                   String           @id @default(uuid())
  cookieDurationDays   Int              @default(30)
  defaultCommissionRate Float           @default(2.5)
  minimumPayoutAmount  Float            @default(1000)
  fraudProtectionActive Boolean         @default(true)
  selfReferralBlocked  Boolean          @default(true)
  updatedAt            DateTime         @updatedAt
}

// Prosify Awas Mitra / Growth Partner Model
model Affiliate {
  id                   String            @id @default(uuid())
  name                 String
  email                String            @unique
  phone                String
  referralCode         String            @unique // e.g. AM-RAHUL24
  customSlug           String?           @unique
  tier                 String            @default("Awas Mitra 2.5%") // Awas Mitra 2.5%, Gold 3.0%, Prime 3.5%
  commissionRate       Float             @default(2.5) // 2.5%, 3.0%, 3.5%
  availableBalance     Float             @default(0.0) // Withdrawable Balance (₹)
  pendingCommission    Float             @default(0.0) // Pipeline Commission (₹)
  lifetimeEarnings     Float             @default(0.0)
  totalClicks          Int               @default(0) // Link Clicks (30d)
  totalLeads           Int               @default(0) // My Leads & Site Visits
  status               String            @default("ACTIVE") // ACTIVE, SUSPENDED
  upiId                String?
  bankName             String?
  bankAccountNumber    String?
  bankIfscCode         String?
  accountHolderName    String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  payouts              AffiliatePayout[]
  leads                AffiliateLead[]
}

// Dedicated Affiliate Lead attribution & milestone tracking
model AffiliateLead {
  id                   String            @id @default(uuid())
  affiliateId          String
  affiliate            Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clientName           String
  clientPhone          String            // stored in full, masked on UI (+91 98******21)
  clientEmail          String?
  projectName          String
  propertySlug         String?
  budgetRange          String?
  status               String            @default("NEW_INQUIRY") // NEW_INQUIRY, VERIFIED, SITE_VISIT_DONE, BOOKED, CLOSED
  siteVisitBonusEarned Float             @default(0.0) // ₹500 milestone bonus on verified site visit
  dealValue            Float?            // Agreement value
  commissionAmount     Float?            // 2.5% to 3.5% of agreement value
  commissionStage      String            @default("PENDING") // PENDING, VERIFIED, UNLOCKED, PAID
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// Weekly UPI/NEFT Payouts with UTR Tracking
model AffiliatePayout {
  id                   String            @id @default(uuid())
  affiliateId          String
  affiliate            Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount               Float
  tdsDeduction         Float             @default(0.0) // 5% TDS
  netPayable           Float
  paymentMethod        String            @default("UPI") // UPI, NEFT, IMPS
  destinationDetails   String            // UPI ID or Account Number + IFSC
  status               String            @default("PENDING") // PENDING, PROCESSING, PROCESSED, REJECTED
  utrNumber            String?           // Bank UTR number
  notes                String?
  requestedAt          DateTime          @default(now())
  processedAt          DateTime?
}


