{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prosify",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "prosify-real-estate"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prosify_production",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "801fe9ecb7d04f2884fe6701c36cfff9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "prosify-cache"
    },
    {
      "binding": "R2_UPLOADS",
      "bucket_name": "prosify-uploads"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SITE_NAME": "Prosify Luxury Real Estate"
  }
}
